# Copy this file to .env and fill in your key. .env is git-ignored: never commit a real key.
OPENAI_API_KEY=your-key-here

# Cornell AI API Gateway (as used in INFO 5940). To use api.openai.com instead, delete
# OPENAI_BASE_URL and use plain model names such as gpt-4o / text-embedding-3-small.
OPENAI_BASE_URL=https://api.ai.it.cornell.edu/
CHAT_MODEL=openai.gpt-4o
EMBED_MODEL=openai.text-embedding-3-large

# Optional overrides (defaults shown)
# ASSISTANT_NAME=Chinook Records
# DOCS_DIR=data/docs
# SQLITE_DB=data/chinook.db
# CHROMA_DIR=.chroma
# CHUNK_SIZE=600
# CHUNK_OVERLAP=100

# Offline demo mode: no API calls (hash embeddings + rule-based stand-in model).
# RAG_FAKE=1
